@using Demo.Presentation.ViewModels.UserViewModels
@model UserVM
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    
    <div class="col-md-6">
        <label class="form-label fw-bold" asp-for="Fname">First Name</label>
        <input class="form-control" asp-for="@Model.Fname" />
        <span asp-validation-for="Fname" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold" asp-for="Lname">Last Name</label>
        <input class="form-control" asp-for="@Model.Lname" />
        <span asp-validation-for="Lname" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold" asp-for="PhoneNumber">Phone Number</label>
        <input class="form-control" asp-for="@Model.PhoneNumber" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <input type="submit" value="Save" class="btn btn-warning" />
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
