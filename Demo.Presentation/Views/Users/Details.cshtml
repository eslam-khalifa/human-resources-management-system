@using Demo.Presentation.ViewModels.UserViewModels
@model UserVM
@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@Model.Fname @Model.Lname Details</h1>

<div class="col-md-6">
    <label class="form-label fw-bold" asp-for="Id">Id</label>
    <input readonly class="form-control" asp-for="@Model.Id" />
</div>

<div class="col-md-6">
    <label class="form-label fw-bold" asp-for="Fname">First Name</label>
    <input readonly class="form-control" asp-for="@Model.Fname" />
</div>

<div class="col-md-6">
    <label class="form-label fw-bold" asp-for="Lname">Last Name</label>
    <input readonly class="form-control" asp-for="@Model.Lname" />
</div>

<div class="col-md-6">
    <label class="form-label fw-bold" asp-for="PhoneNumber">Phone Number</label>
    <input readonly class="form-control" asp-for="@Model.PhoneNumber" />
</div>

<div class="col-md-6">
    <label class="form-label fw-bold" asp-for="Email">Email Address</label>
    <input readonly class="form-control" asp-for="@Model.Email" />
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
