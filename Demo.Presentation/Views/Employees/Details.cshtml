@using Demo.BusinessLogic.DataTransferObjects.EmployeeDTOs
@model EmployeeDetailsDTO

<h2>Employee Details</h2>

<div class="row mb-2">
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(Model.ImageName))
        {
            <img src="~/Files/Images/@Model.ImageName"
                 alt="Employee Image"
                 style="max-width:200px; border-radius:10px; margin-bottom:10px" />
        }
        else
        {
            <p class="text-muted">No image uploaded</p>
        }
    </div>
</div>

<!-- Navbar Tabs -->
<ul class="nav nav-tabs" id="employeeTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab">
            General
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="administration-tab" data-bs-toggle="tab" data-bs-target="#administration" type="button" role="tab">
            Administration
        </button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content mt-3" id="employeeTabContent">
    <!-- General Tab -->
    <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
        <div class="row mb-2">
            <div class="col-md-6">
                <label class="form-label fw-bold">Name</label>
                <input type="text" class="form-control" value="@Model.Name" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Age</label>
                <input type="text" class="form-control" value="@Model.Age" readonly />
            </div>
        </div>

        <div class="row mb-2">
            <div class="mb-2">
                <label class="form-label fw-bold">Address</label>
                <input type="text" class="form-control" value="@Model.Address" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Department</label>
                <input type="text" class="form-control" value="@Model.Department" readonly />
            </div>
        </div>

        <div class="row mb-2">
            <div class="col-md-6">
                <label class="form-label fw-bold">Gender</label>
                <input type="text" class="form-control" value="@Model.Gender" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Employee Type</label>
                <input type="text" class="form-control" value="@Model.EmployeeType" readonly />
            </div>
        </div>
    </div>

    <!-- Administration Tab -->
    <div class="tab-pane fade" id="administration" role="tabpanel" aria-labelledby="administration-tab">
        <div class="mb-2">
            <label class="form-label fw-bold">Salary</label>
            <input type="text" class="form-control" value="@Model.Salary" readonly />
        </div>

        <div class="mb-2">
            <label class="form-label fw-bold">Email</label>
            <input type="text" class="form-control" value="@Model.Email" readonly />
        </div>

        <div class="mb-2">
            <label class="form-label fw-bold">Phone Number</label>
            <input type="text" class="form-control" value="@Model.PhoneNumber" readonly />
        </div>

        <div class="mb-2">
            <label class="form-label fw-bold">Hiring Date</label>
            <input type="text" class="form-control" value="@Model.HiringDate" readonly />
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
