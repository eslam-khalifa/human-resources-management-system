@using Demo.BusinessLogic.DataTransferObjects
@using Demo.BusinessLogic.DataTransferObjects.DepartmentDTOs
@model DepartmentDetailsDTO

<h2>Department Details</h2>

<!-- Tabs -->
<ul class="nav nav-tabs">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#general">General</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#administration">Administration</a>
    </li>
</ul>

<div class="tab-content mt-3">
    <!-- General Tab -->
    <div class="tab-pane fade show active" id="general">
        <div class="row mb-2">
            <div class="col-md-6">
                <label class="form-label fw-bold">Code</label>
                <input type="text" class="form-control" value="@Model.Code" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Name</label>
                <input type="text" class="form-control" value="@Model.Name" readonly />
            </div>
        </div>

        <div class="mb-2">
            <label class="form-label fw-bold">Description</label>
            <input type="text" class="form-control" value="@Model.Description" readonly />
        </div>

        <div class="mb-2">
            <label class="form-label fw-bold">DateOfCreation</label>
            <input type="text" class="form-control" value="@Model.CreatedOn" readonly />
        </div>
    </div>

    <!-- Administration Tab -->
    <div class="tab-pane fade" id="administration">
        <div class="mb-2">
            <label class="form-label fw-bold">CreatedBy</label>
            <input type="text" class="form-control" value="@Model.CreatedBy" readonly />
        </div>

        <div class="mb-2">
            <label class="form-label fw-bold">CreatedOn</label>
            <input type="text" class="form-control" value="@Model.CreatedOn" readonly />
        </div>

        <div class="mb-2">
            <label class="form-label fw-bold">LastModifiedBy</label>
            <input type="text" class="form-control" value="@Model.LastModifiedBy" readonly />
        </div>

        <div class="mb-2">
            <label class="form-label fw-bold">LastModifiedOn</label>
            <input type="text" class="form-control" value="@Model.LastModifiedOn" readonly />
        </div>
    </div>
</div>

<!-- Buttons -->
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back To list</a>
</div>
