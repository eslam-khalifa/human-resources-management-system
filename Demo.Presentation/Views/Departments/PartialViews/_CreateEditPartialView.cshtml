@model DepartmentVM

<div class="mb-3">
    <label asp-for="Code" class="form-label text-muted">Code</label>
    <input asp-for="Code" class="form-control" />
    <span asp-validation-for="Code" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Name" class="form-label text-muted">Name</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label text-muted">Description</label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="mb-4">
    <label asp-for="DateOfCreation" class="form-label text-muted">DateOfCreation</label>
    <input asp-for="DateOfCreation" type="date" class="form-control" />
    <span asp-validation-for="DateOfCreation" class="text-danger"></span>
</div>