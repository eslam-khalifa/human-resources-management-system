@using Demo.Presentation.ViewModels.RoleViewModels
@model IEnumerable<RoleVM>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>All Roles</h1>

<a class="btn btn-primary my-3" asp-controller="Roles" asp-action="Create">Create New Role</a>

<br />

<form method="get" asp-action="Index" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchValue" class="form-control" placeholder="Search by name" value="@Context.Request.Query["searchValue"]" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (Model.Any())
{
    <table class="table table-striped table-hover mt-5">
        <thead>
            <tr>
                <td>@Html.DisplayNameFor(r => r.Id)</td>
                <td>@Html.DisplayNameFor(r => r.RoleName)</td>
                <td>Details</td>
                <td>Update</td>
                <td>Delete</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var Role in Model)
            {
                <tr>
                    <td>@Role.Id</td>
                    <td>@Role.RoleName</td>
                    @{
                        await Html.RenderPartialAsync("_ButtonsPartialView", new ActionButtonsVM { Id = Role.Id.ToString(), Controller = "Roles" });
                    }
                    <td>
                        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@Role.Id" data-name="@Role.RoleName">
                            <i class="fas fa-trash"></i>
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-2">
        <h1>There is no roles</h1>
    </div>
}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete <strong id="roleName"></strong>?
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <input type="hidden" name="id" id="roleId" />
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var roleId = button.getAttribute('data-id');
            var roleName = button.getAttribute('data-name');

            document.getElementById('roleId').value = roleId;
            document.getElementById('roleName').innerText = roleName;

            document.getElementById('deleteForm').action = '/Roles/DeleteConfirmed/' + roleId;
        });
    </script>
}



